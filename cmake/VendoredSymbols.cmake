# Helpers to give the global symbols of vendored C libraries (glad, stb_image) a projectM-specific prefix.
#
# libprojectM builds these libraries into its own binary. Their symbols are hidden in shared builds, but a
# static libprojectM exports them, so an application that links it and also uses its own copy of glad or
# stb_image would get duplicate or mismatched symbols. Instead of editing the vendored code, a generated
# header "#define"s each global symbol to a prefixed name, and it is force-included into every translation
# unit that defines or uses these symbols. See issue #1038.

set(PROJECTM_VENDORED_SYMBOL_PREFIX "projectM_")

# Collects symbol names from declaration lines in the given files.
#   projectm_vendored_symbols_from_declarations(<out_var> <line_regex> <file>...)
# <line_regex> selects the declaration lines, e.g. "^GLAD_API_CALL ". For each selected line, the name in
# front of the first "(" is taken (functions), or else the last name on the line (variables).
function(projectm_vendored_symbols_from_declarations out_var line_regex)
    set(_symbols "")
    foreach(_file IN LISTS ARGN)
        file(STRINGS "${_file}" _lines REGEX "${line_regex}")
        # file(STRINGS) keeps each line, including the declaration's trailing ";", as one list element.
        foreach(_line IN LISTS _lines)
            if(_line MATCHES "([A-Za-z_][A-Za-z0-9_]*)[ \t]*\\(")
                list(APPEND _symbols "${CMAKE_MATCH_1}")
            elseif(_line MATCHES "([A-Za-z_][A-Za-z0-9_]*)[ \t]*;?[ \t]*$")
                list(APPEND _symbols "${CMAKE_MATCH_1}")
            endif()
        endforeach()
    endforeach()
    list(REMOVE_DUPLICATES _symbols)
    set(${out_var} "${_symbols}" PARENT_SCOPE)
endfunction()

# Writes a header that "#define"s each symbol to its prefixed name, and returns the compile option that
# force-includes it.
#   projectm_write_vendored_symbol_header(<out_option_var> <header_path> <library_name> <symbol>...)
function(projectm_write_vendored_symbol_header out_option_var header_path library_name)
    set(_symbols ${ARGN})
    list(REMOVE_DUPLICATES _symbols)
    list(SORT _symbols)

    string(MAKE_C_IDENTIFIER "PROJECTM_${library_name}_SYMBOL_PREFIX_H" _guard)
    string(TOUPPER "${_guard}" _guard)
    set(_content "/*\n * Generated by CMake (cmake/VendoredSymbols.cmake), do not edit.\n *\n")
    string(APPEND _content " * Gives the global symbols of the vendored ${library_name} code a projectM-specific prefix, so a\n")
    string(APPEND _content " * static libprojectM doesn't clash with an application's own copy of ${library_name}.\n */\n")
    string(APPEND _content "#ifndef ${_guard}\n#define ${_guard}\n\n")
    foreach(_symbol IN LISTS _symbols)
        string(APPEND _content "#define ${_symbol} ${PROJECTM_VENDORED_SYMBOL_PREFIX}${_symbol}\n")
    endforeach()
    string(APPEND _content "\n#endif /* ${_guard} */\n")

    # Only touch the header if it changed, so it doesn't trigger rebuilds on every configure run.
    file(WRITE "${header_path}.tmp" "${_content}")
    configure_file("${header_path}.tmp" "${header_path}" COPYONLY)

    if(MSVC)
        set(${out_option_var} "/FI${header_path}" PARENT_SCOPE)
    else()
        set(${out_option_var} "SHELL:-include \"${header_path}\"" PARENT_SCOPE)
    endif()
endfunction()
